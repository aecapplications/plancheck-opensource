{
  "schema_version": "0.1",
  "source_corpus": "2022 California Residential Code (Title 24 Part 2.5)",
  "rule_pack": "Alternative Wall Systems",
  "community_id": 10,
  "extracted_from_sections": [
    "appendix_ah_patio_covers.md",
    "appendix_ar_light_straw_clay_construction.md",
