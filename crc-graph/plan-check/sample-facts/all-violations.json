      "rule_id": "rule_r316_3_foam_plastic_surface_burning",
      "cite": "R316.3",
      "section_node": "r316_3",
      "title": "Foam plastic surface burning characteristics",
      "severity": "required",
      "jurisdiction": "model_IRC",
      "requires": {
        "type": "foam_plastic_surface_burning_characteristics",
        "flame_spread_index_max": 75,
        "smoke_developed_index_max": 450,
        "tested_per": [
          "std_astm_e84"
        ],
        "alternate_tested_per": [
          "UL 723"
        ],
        "thickness_rules": {
          "<=4_in": "test at maximum thickness and density intended for use",
          ">4_in": "test at 4-inch thickness; end use approved per R316.6"
        },
        "loose_fill_treatment": "tested as board stock"
      },
      "evidence_required": [
        "Foam plastic product spec sheet listing flame spread index and smoke-developed index values",
        "ASTM E84 or UL 723 test report at intended thickness and density",
        "Manufacturer's listing showing thickness, density, and end-use configuration",
        "If thicker than 4 in: R316.6 specific approval documentation"
      ],
      "depends_on": [
        "std_astm_e84"
      ],
      "matched_conditions": [
        "uses_foam_plastic_in_building_construction",
        "not"
      ],
      "partially_suppressed_by": [
        {
          "exception_id": "ex1",
          "effect": "alternative_thresholds: flame_spread_index_max=25, smoke_developed_index_max=450 at 4-inch test thickness; must be separated from interior by 1/2-inch gypsum or NFPA 275 tested material"
        }
      ]
    },
