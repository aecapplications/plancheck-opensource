          "effect": "rule_does_not_apply"
        },
        {
          "id": "ex2",
          "applies_when": [
            {
              "predicate": "is_group_u_agricultural_building",
              "source_loc": "R337.1.3 Exception 2"
            },
            {
              "predicate": "distance_from_applicable_building_>=50_ft",
              "source_loc": "R337.1.3 Exception 2"
            }
          ],
          "effect": "rule_does_not_apply"
        },
        {
          "id": "ex3",
          "applies_when": [
            {
              "predicate": "is_addition_or_remodel_of_pre_2008_07_01_building",
              "source_loc": "R337.1.3 Exception 5"
            }
          ],
          "effect": "rule_does_not_apply"
        }
      ],
      "evidence_required": [
