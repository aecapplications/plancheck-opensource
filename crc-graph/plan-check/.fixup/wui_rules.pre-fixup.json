      "amends": null,
      "jurisdiction": "California",
      "severity": "required"
    },
    {
      "id": "rule_r337_5_2_wui_roof_coverings_airspace",
      "cite": "R337.5.2",
      "section_node": "r337_5_2",
      "title": "WUI roof coverings — cap sheet under profiled roofing on combustible deck",
      "intent": "Prevent ember intrusion under profiled (airspace) roof coverings on combustible decks by requiring an underlayment cap sheet, bird stops, and mudded hip/ridge caps.",
      "applies_when": [
