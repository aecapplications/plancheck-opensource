              "source_loc": "R337.1.2"
            }
          ]
        },
        {
          "predicate": "is_new_building",
          "source_loc": "R337.1.3"
        },
        {
          "predicate": "permit_application_date_>=_2008_07_01",
          "source_loc": "R337.1.3.1"
        }
      ],
      "requires": {
        "type": "scope_trigger",
        "activates_subtree": [
          "r337_4",
          "r337_5",
          "r337_6",
          "r337_7",
          "r337_8",
          "r337_9",
          "r337_10"
        ]
      },
      "exceptions": [
        {
