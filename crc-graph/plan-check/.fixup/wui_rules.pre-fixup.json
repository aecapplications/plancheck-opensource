    {
      "id": "rule_r337_scope_wui_application",
      "cite": "R337.1.1",
      "section_node": "section_r337",
      "title": "WUI exterior wildfire exposure scope (parent trigger)",
      "intent": "Scope rule: triggers application of the entire R337 ignition-resistance rule subtree for new buildings located in WUI fire areas or Fire Hazard Severity Zones.",
      "applies_when": [
        {
