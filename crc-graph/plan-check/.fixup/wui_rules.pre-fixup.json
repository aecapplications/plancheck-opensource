        {
          "predicate": "installed_on_or_above_roof_covering",
          "source_loc": "R324.4"
        }
      ],
      "requires": {
        "type": "pv_fire_classification",
        "must_match": "fire_classification_of_roof_assembly_per_r902",
        "tested_per": [
          "std_ul_2703"
        ],
        "depends_on_section": "section_r902"
      },
      "exceptions": [],
      "evidence_required": [
        "PV module/system listing showing UL 2703 fire classification (Class A, B, or C)",
        "Roof assembly fire classification (Class A in FHSZ per R902.1.1)",
        "Cross-check showing PV class is at least equal to roof class",
        "Manufacturer installation instructions and product listing"
      ],
      "depends_on": [
        "std_ul_2703",
        "r902_1_1",
        "section_r902"
      ],
      "amends": null,
      "jurisdiction": "model_IRC",
      "severity": "required"
    },
