      "jurisdiction": "California",
      "severity": "required"
    },
    {
      "id": "rule_r337_4_ignition_resistant_material",
      "cite": "R337.4",
      "section_node": "r337_4",
      "title": "Ignition-resistant material requirements",
      "intent": "Ensure exterior building materials used in WUI areas demonstrate ignition resistance through standardized fire testing or qualify as a recognized alternative (noncombustible, FRTW, FRT shingles).",
      "applies_when": [
        {
          "predicate": "in_wildland_urban_interface_fire_area",
          "source_loc": "R337.1.1"
        },
        {
          "predicate": "material_required_to_be_ignition_resistant_per_r337",
          "source_loc": "R337.4.1"
        }
      ],
      "requires": {
        "type": "ignition_resistant_material",
        "any_of": [
          {
            "method": "tested_to_astm_e84_or_ul_723_extended",
            "flame_spread_index_max": 25,
            "extended_test_minutes": 30,
            "extended_flame_front_progression_max_ft": 10.5,
            "tested_per": [
              "std_astm_e84"
            ]
          },
          {
            "method": "noncombustible_per_r202"
          },
          {
            "method": "fire_retardant_treated_wood_per_cbc_2303_2"
          },
          {
            "method": "frt_wood_shingles_shakes_class_b_per_cbc_1505_6"
          }
        ],
        "wood_structural_panel_test_condition": "1/8-inch longitudinal gap"
      },
      "exceptions": [],
      "evidence_required": [
        "Product listing showing ASTM E84 / UL 723 extended (30-min) flame spread index <= 25",
        "Test report showing flame front did not progress > 10.5 ft beyond burner centerline",
        "If FRTW: ASTM D2898 weathering test report and CBC 2303.2 compliance",
        "State Fire Marshal listing or approved-agency evaluation report",
        "Identification label on product (R337.3.4)"
      ],
      "depends_on": [
        "std_astm_e84"
      ],
      "amends": null,
      "jurisdiction": "California",
      "severity": "required"
    },
    {
