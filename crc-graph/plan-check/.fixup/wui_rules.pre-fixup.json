    {
      "id": "rule_r337_8_exterior_glazing",
      "cite": "R337.8",
      "section_node": "r337_8",
      "title": "WUI exterior windows, skylights, and exterior glazed doors",
      "intent": "Require exterior glazing to resist breakage from radiant heat and direct flame so that fire and embers do not enter through window/skylight/door openings.",
