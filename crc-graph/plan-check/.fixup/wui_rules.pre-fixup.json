  "rules": [
    {
      "id": "rule_r316_3_foam_plastic_surface_burning",
      "cite": "R316.3",
      "section_node": "r316_3",
      "title": "Foam plastic surface burning characteristics",
      "intent": "Limit flame spread and smoke development of foam plastic used in building construction so that it does not contribute to rapid interior fire growth.",
      "applies_when": [
        {
          "predicate": "uses_foam_plastic_in_building_construction",
          "source_loc": "R316.3"
        },
        {
          "predicate": "not",
          "of": [
            {
              "predicate": "approved_under_section_r316_5",
              "source_loc": "R316.3"
            }
          ]
        }
      ],
      "requires": {
        "type": "foam_plastic_surface_burning_characteristics",
        "flame_spread_index_max": 75,
        "smoke_developed_index_max": 450,
        "tested_per": [
          "std_astm_e84"
        ],
        "alternate_tested_per": [
          "UL 723"
        ],
        "thickness_rules": {
          "<=4_in": "test at maximum thickness and density intended for use",
          ">4_in": "test at 4-inch thickness; end use approved per R316.6"
        },
        "loose_fill_treatment": "tested as board stock"
      },
      "exceptions": [
        {
          "id": "ex1",
          "applies_when": [
            {
              "predicate": "is_spray_foam_plastic_insulation",
              "source_loc": "R316.3 Exception 1"
            },
            {
              "predicate": "thickness_>_4_in",
              "source_loc": "R316.3 Exception 1"
            }
          ],
          "effect": "alternative_thresholds: flame_spread_index_max=25, smoke_developed_index_max=450 at 4-inch test thickness; must be separated from interior by 1/2-inch gypsum or NFPA 275 tested material"
        },
        {
          "id": "ex2",
          "applies_when": [
            {
              "predicate": "is_polystyrene_foam_board",
              "source_loc": "R316.3 Exception 2"
            },
            {
              "predicate": "thickness_<=2_in",
              "source_loc": "R316.3 Exception 2"
            },
            {
              "predicate": "installed_below_concrete_slab_on_grade_>=3_5_in",
              "source_loc": "R316.3 Exception 2"
            }
          ],
          "effect": "rule_does_not_apply"
        }
      ],
      "evidence_required": [
        "Foam plastic product spec sheet listing flame spread index and smoke-developed index values",
        "ASTM E84 or UL 723 test report at intended thickness and density",
        "Manufacturer's listing showing thickness, density, and end-use configuration",
        "If thicker than 4 in: R316.6 specific approval documentation"
      ],
      "depends_on": [
        "std_astm_e84"
      ],
      "amends": null,
      "jurisdiction": "model_IRC",
      "severity": "required"
    },
    {
      "id": "rule_r324_4_2_pv_fire_classification",
      "cite": "R324.4.2",
      "section_node": "r324_4_2",
      "title": "Rooftop PV fire classification matches roof assembly",
      "intent": "Ensure rooftop-mounted photovoltaic systems do not degrade the fire classification of the roof they are installed on.",
      "applies_when": [
        {
          "predicate": "is_pv_rooftop_mounted",
          "source_loc": "R324.4.2"
