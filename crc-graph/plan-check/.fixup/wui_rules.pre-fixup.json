            {
              "predicate": "is_exterior_window",
              "source_loc": "R337.8.2"
            },
            {
              "predicate": "is_exterior_glazed_door",
              "source_loc": "R337.8.2"
            },
            {
              "predicate": "is_skylight",
              "source_loc": "R337.8.2"
