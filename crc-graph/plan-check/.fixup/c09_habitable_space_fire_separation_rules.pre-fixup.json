    {
      "id": "rule_r303_1_habitable_rooms_light_and_ventilation",
      "cite": "R303.1",
      "section_node": "section_r303_1_habitable_rooms",
      "title": "Habitable rooms: minimum natural light and ventilation",
      "intent": "Provide minimum natural daylighting and outdoor-air ventilation to each habitable room, or compensate with mechanical ventilation and artificial light meeting prescribed levels.",
      "applies_when": [
        {
          "is_habitable_room": true
        }
      ],
      "requires": {
        "type": "natural_light_and_ventilation",
        "min_aggregate_glazing_area_pct_of_floor_area": 8,
        "min_openable_area_to_outdoors_pct_of_floor_area_being_ventilated": 4,
        "ventilation_path": "windows, skylights, doors, louvers or other approved openings to the outdoor air",
        "access": "ready access or readily controllable by the building occupants",
        "tested_per": []
      },
      "exceptions": [
        {
          "id": "ex1",
          "applies_when": [
            {
              "all_of": [
                {
                  "is_habitable_room_other_than_kitchen": true
                },
                {
                  "opening_not_required_by_R310_egress": true
                },
                {
                  "any_of": [
                    {
                      "whole_house_mechanical_ventilation_per_california_mechanical_code": true
                    },
                    {
                      "mechanical_ventilation_capable_of_0_35_air_changes_per_hour_in_habitable_rooms_per_california_mechanical_code": true
                    }
                  ]
                }
              ]
            }
          ],
          "effect": "glazed_areas_need_not_be_openable"
        },
        {
          "id": "ex2",
          "applies_when": [
            {
              "all_of": [
                {
                  "is_kitchen": true
                },
                {
                  "opening_not_required_by_R310_egress": true
                },
                {
                  "local_exhaust_system_per_california_mechanical_code": true
                }
              ]
            }
          ],
          "effect": "glazed_areas_need_not_be_openable"
        },
        {
          "id": "ex3",
          "applies_when": [
            {
              "all_of": [
                {
                  "exception_1_satisfied": true
                },
                {
                  "artificial_light_provides_>=_6_footcandles_at_30_in_above_floor": true
                }
              ]
            }
          ],
          "effect": "glazed_areas_need_not_be_installed"
        },
        {
          "id": "ex4",
          "applies_when": [
            {
              "all_of": [
                {
                  "is_sunroom_or_patio_cover_per_R202": true
                },
                {
                  "exterior_sunroom_walls_open_or_insect_screen_only_pct_>_40": true
                }
              ]
            }
          ],
          "effect": "natural_ventilation_via_sunroom_permitted"
        },
        {
          "id": "ex5",
          "applies_when": [
            {
              "all_of": [
                {
                  "openings_open_into_passive_solar_energy_collector": true
                },
                {
                  "ventilation_openings_to_outside_of_collector_increased_to_compensate": true
                }
              ]
            }
          ],
          "effect": "alternative_ventilation_path_permitted"
        },
        {
          "id": "ex6",
          "applies_when": [
            {
              "all_of": [
                {
                  "glazed_openings_open_into_passive_solar_energy_collector": true
                },
                {
                  "exterior_glazed_opening_area_into_collector_increased_to_compensate": true
                }
              ]
            }
          ],
          "effect": "alternative_light_path_permitted"
        }
      ],
      "evidence_required": [
        "Room-by-room schedule listing floor area, required glazing area (>=8%), and provided glazing area for each habitable room",
        "Window/door schedule showing openable area (>=4% of floor area being ventilated)",
        "Mechanical ventilation calculations and equipment cut sheets if relying on Exception 1 or 2 (whole-house ventilation or kitchen local exhaust)",
        "Lighting calculation demonstrating >=6 footcandles at 30 in above floor where Exception 3 is used",
        "Floor plan and section confirming room qualifies as 'habitable space' per Chapter 2 definition"
      ],
      "depends_on": [
        "def_habitable_space",
        "section_r310_egress",
        "section_r304",
        "section_r305"
      ],
      "amends": null,
      "jurisdiction": "California",
      "severity": "required"
    },
    {
      "id": "rule_r304_minimum_room_areas",
      "cite": "R304",
      "section_node": "section_r304",
      "title": "Habitable rooms: minimum floor area and minimum horizontal dimension",
      "intent": "Ensure each habitable room is large enough and proportioned to be usable for living, sleeping, eating or cooking.",
      "applies_when": [
        {
          "is_habitable_room": true
        }
      ],
      "requires": {
        "type": "minimum_room_geometry",
        "min_floor_area_sq_ft": 70,
        "min_horizontal_dimension_ft": 7,
        "low_height_area_exclusion": {
          "sloping_ceiling_below_ft": 5,
          "furred_ceiling_below_ft": 7,
          "effect": "portions below these heights shall not be considered as contributing to the minimum required habitable area"
        },
        "tested_per": []
      },
      "exceptions": [
        {
          "id": "ex1_min_area",
          "applies_when": [
            {
              "is_kitchen": true
            }
          ],
          "effect": "minimum_floor_area_does_not_apply"
        },
        {
          "id": "ex1_min_dim",
          "applies_when": [
            {
              "is_kitchen": true
            }
          ],
          "effect": "minimum_horizontal_dimension_does_not_apply"
        },
        {
          "id": "ex2_min_dim",
          "applies_when": [
            {
              "is_limited_density_owner_built_rural_dwelling_per_R301_1_1_1": true
            }
          ],
          "effect": "minimum_horizontal_dimension_does_not_apply"
        }
      ],
      "evidence_required": [
        "Floor plan with dimensioned habitable rooms showing area >= 70 sq ft and shortest horizontal dimension >= 7 ft",
        "Building section indicating ceiling slope/furring with shaded exclusion of areas below the 5 ft (sloped) / 7 ft (furred) heights",
        "Room schedule classifying each room as habitable vs. non-habitable per Chapter 2 definition",
        "Tabulated calculation of qualifying habitable area (gross area minus low-height exclusions)"
      ],
      "depends_on": [
        "def_habitable_space",
        "section_r305"
      ],
      "amends": null,
      "jurisdiction": "model_IRC",
      "severity": "required"
    },
    {
      "id": "rule_r305_ceiling_height",
      "cite": "R305.1",
      "section_node": "section_r305",
      "title": "Minimum ceiling height in habitable space and other rooms",
      "intent": "Provide adequate vertical clearance in habitable rooms, hallways, and basements containing them, with reduced minimums for bathrooms, toilet rooms, laundry rooms, and obstruction zones.",
      "applies_when": [
        {
          "any_of": [
            {
              "is_habitable_space": true
            },
            {
              "is_hallway": true
            },
            {
              "is_portion_of_basement_containing_habitable_space_or_hallway": true
            },
            {
              "is_bathroom_toilet_room_or_laundry_room": true
            },
            {
              "is_portion_of_basement_not_containing_habitable_space_or_hallway": true
            }
          ]
        }
      ],
      "requires": {
        "type": "minimum_ceiling_height",
        "rules": [
          {
            "applies_to": "habitable space, hallways, and portions of basements containing these spaces",
            "min_ceiling_height_ft_in": "7 ft (2134 mm)"
          },
          {
            "applies_to": "bathrooms, toilet rooms, and laundry rooms",
            "min_ceiling_height_ft_in": "6 ft 8 in (2032 mm)"
          },
          {
            "applies_to": "portions of basements not containing habitable space or hallways (R305.1.1)",
            "min_ceiling_height_ft_in": "6 ft 8 in (2032 mm)"
          }
        ],
        "tested_per": []
      },
      "exceptions": [
        {
          "id": "ex1",
          "applies_when": [
            {
              "all_of": [
                {
                  "room_has_sloped_ceiling": true
                },
                {
                  "min_ceiling_height_in_required_floor_area_ft_>=_5": true
                },
                {
                  "pct_of_required_floor_area_with_ceiling_>=_7_ft_>=_50": true
                }
              ]
            }
          ],
          "effect": "sloped_ceiling_compliance_path"
        },
        {
          "id": "ex2",
          "applies_when": [
            {
              "all_of": [
                {
                  "is_above_bathroom_or_toilet_room_fixtures": true
                },
                {
                  "fixture_is_capable_of_being_used_for_intended_purpose": true
                },
                {
                  "any_of": [
                    {
                      "not": {
                        "is_shower_or_tub_with_showerhead": true
                      }
                    },
                    {
                      "all_of": [
                        {
                          "is_shower_or_tub_with_showerhead": true
                        },
                        {
                          "ceiling_height_above_30in_x_30in_at_showerhead_>=_6_ft_8_in": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "effect": "fixture_clearance_path"
        },
        {
          "id": "ex3",
          "applies_when": [
            {
              "all_of": [
                {
                  "is_basement_with_habitable_space": true
                },
                {
                  "obstruction_is_beam_girder_duct_or_similar": true
                },
                {
                  "obstruction_clearance_to_finished_floor_ft_in_>=_6_4": true
                }
              ]
            }
          ],
          "effect": "basement_obstruction_path"
        },
        {
          "id": "ex4",
          "applies_when": [
            {
              "all_of": [
                {
                  "obstruction_is_beam_or_girder": true
                },
                {
                  "clear_finished_width_between_beams_in_>=_36": true
                },
                {
                  "projection_from_finished_floor_in_<=_78": true
                }
              ]
            }
          ],
          "effect": "spaced_beam_path"
        },
        {
          "id": "ex5_basement_obstructions",
          "applies_when": [
            {
              "all_of": [
                {
                  "is_basement_without_habitable_space_or_hallways": true
                },
                {
                  "obstruction_is_beam_girder_duct_or_similar": true
                },
                {
                  "obstruction_clearance_to_finished_floor_ft_in_>=_6_4": true
                }
              ]
            }
          ],
          "effect": "basement_obstruction_path_for_nonhabitable_basement"
        }
      ],
      "evidence_required": [
        "Building sections showing finished ceiling heights in habitable rooms (>=7 ft), bathrooms/toilet rooms/laundry (>=6 ft 8 in), and basements",
        "Floor plan with ceiling height tags by room",
        "Sloped-ceiling compliance diagram showing area with ceiling >=7 ft as a percentage of required floor area, and >=5 ft minimum",
        "Detail at showerhead area showing 30 in x 30 in clear footprint with >=6 ft 8 in clearance",
        "Section through basement showing duct/beam clearances meeting 6 ft 4 in or 78 in projection limits"
      ],
      "depends_on": [
        "def_habitable_space",
        "section_r304"
      ],
      "amends": null,
      "jurisdiction": "model_IRC",
      "severity": "required"
    }
  ]
}
